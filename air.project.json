{
  "schema": "air.project",
  "version": 1,
  "package": {
    "name": "airpolo",
    "version": "0.1.0",
    "description": "AirPolo: a native AIR file manager (Polo port) with a reusable toolkit layer.",
    "license": "MIT",
    "notices": [
      "LICENSE"
    ]
  },
  "targets": {
    "lib": "toolkit/fsops.ai",
    "bin": [
      {
        "name": "airpolo",
        "entry": "src/main.ai"
      }
    ],
    "test": [
      {
        "name": "unit",
        "entry": "tests/unit.ai"
      }
    ]
  },
  "sources": [
    "src",
    "toolkit",
    "tests"
  ],
  "requires": {
    "os": [
      "linux"
    ],
    "arch": [
      "x86_64"
    ]
  },
  "desktop": [
    {
      "id": "airpolo",
      "name": "AirPolo",
      "comment": "Native AIR file manager",
      "categories": "Utility;FileTools;",
      "launcher": "airpolo"
    }
  ]
}